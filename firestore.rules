rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == 'owner-pending-verification' && uid == request.auth.uid;
    }
    function number(v,low,high) { return (v is int || v is float) && v >= low && v <= high; }
    function optional(d,k,low,high) { return !(k in d) || d[k] == '' || number(d[k],low,high); }
    function date(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function profile(d) {
      return d is map && d.keys().hasOnly(['age','height','weight','sex','activity','goal','scoops','calorieOverride','start'])
        && d.keys().hasAll(['age','height','weight','sex','activity','goal','scoops','calorieOverride','start'])
        && (d.age == '' || number(d.age,18,100)) && number(d.height,120,230) && number(d.weight,35,250)
        && d.sex in ['male','female'] && d.activity in [1.2,1.375,1.55,1.725] && d.goal in ['cut','maintain','gain']
        && number(d.scoops,0,10) && (d.calorieOverride == '' || number(d.calorieOverride,1200,6000)) && date(d.start);
    }
    function nutrition(d) {
      return d is map && d.keys().hasOnly(['calories','protein','fat','carbs']) && d.keys().hasAll(['calories','protein','fat','carbs'])
        && number(d.calories,0,10000) && number(d.protein,0,600) && number(d.fat,0,500) && number(d.carbs,0,1500);
    }
    function measurement(d,day) {
      return d is map && d.keys().hasOnly(['date','weight','waist','bodyfat','muscle','bodyProtein','proteinMass','metabolism','fatMass','bodyWater','bmi','ecw','inbodyScore','visceralFat','waistHip'])
        && d.date == day && d.keys().hasAny(['weight','waist','bodyfat','muscle','bodyProtein','proteinMass','metabolism','fatMass','bodyWater','bmi','ecw','inbodyScore','visceralFat','waistHip'])
        && optional(d,'weight',35,250) && optional(d,'waist',30,250) && optional(d,'bodyfat',3,60) && optional(d,'muscle',1,150)
        && optional(d,'bodyProtein',1,40) && optional(d,'proteinMass',1,60) && optional(d,'metabolism',500,5000)
        && optional(d,'fatMass',1,180) && optional(d,'bodyWater',5,150) && optional(d,'bmi',10,80) && optional(d,'ecw',0.2,0.6)
        && optional(d,'inbodyScore',0,100) && optional(d,'visceralFat',1,50) && optional(d,'waistHip',0.4,2);
    }
    function session(d) {
      return d is map && d.keys().hasOnly(['complete','exercises']) && d.keys().hasAll(['complete','exercises'])
        && d.complete is bool && d.exercises is map && d.exercises.size() <= 40;
    }
    function identified(d,id) {
      return (d.kind == 'profile' && id == 'profile' && d.date == '' && d.day == -1 && !d.deleted)
        || (date(d.date) && ((d.kind == 'session' && d.day is int && d.day >= 0 && d.day <= 6 && id == 'session_' + d.date + '_' + string(d.day))
          || (d.day == -1 && ((d.kind == 'nutrition' && id == 'nutrition_' + d.date) || (d.kind == 'measurement' && id == 'measurement_' + d.date)))));
    }
    function valid(d,id) {
      return d.keys().hasOnly(['schema','kind','date','day','data','deleted','revision','mutationId','updatedAt'])
        && d.keys().hasAll(['schema','kind','date','day','data','deleted','revision','mutationId','updatedAt'])
        && d.schema == 1 && d.deleted is bool && d.revision is int && d.revision > 0
        && d.mutationId is string && d.mutationId.matches('[a-zA-Z0-9_-]{1,128}') && d.updatedAt == request.time && identified(d,id)
        && ((d.deleted && d.data == null) || (!d.deleted && ((d.kind == 'profile' && profile(d.data))
          || (d.kind == 'nutrition' && nutrition(d.data)) || (d.kind == 'session' && session(d.data)) || (d.kind == 'measurement' && measurement(d.data,d.date)))));
    }
    match /users/{uid}/records/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(request.resource.data,id) && request.resource.data.revision == 1;
      allow update: if owner(uid) && valid(request.resource.data,id) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
